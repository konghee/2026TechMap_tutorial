@Tutorials(name: "RoomAquarium") {
    @Intro(title: "Build an Aquarium in Your Room") {
        Use RealityKit and Reality Composer Pro to put a living aquarium
        inside your own room, on the far side of the iPad camera.

        You start by assembling a 3D scene in Reality Composer Pro, make
        the seahorse swim without writing any code, and finish by floating
        it in your real room and making it respond to a tap.

        @Image(source: "toc-intro", alt: "A virtual aquarium floating in a room, seen on an iPad")
    }

    @Chapter(name: "Building the Scene") {
        Assemble an aquarium scene with a seahorse in Reality
        Composer Pro, then put it on screen with SwiftUI's RealityView.
        You can finish this chapter in the simulator alone.

        @Image(source: "ch1-card", alt: "The aquarium scene laid out in the Reality Composer Pro viewport")

        @TutorialReference(tutorial: "doc:01-BuildingTheScene")
    }

    @Chapter(name: "Bringing It to Life") {
        Make bubbles with a Particle Emitter, set the seahorse swimming
        with a Timeline and a Behavior, and add sound on top.

        @Image(source: "ch2-card", alt: "The aquarium scene with bubble particles rising through it")

        @TutorialReference(tutorial: "doc:02-BringingItToLife")
    }

    @Chapter(name: "Placing It in Your Room") {
        Float the aquarium in your actual room. In Reality Composer Pro you
        make the seahorse respond to a Tap; in Xcode you forward that tap in
        a single line. From this chapter on you need a real device (iPad).

        @Image(source: "ch3-card", alt: "The aquarium placed in a real room in AR")

        @TutorialReference(tutorial: "doc:03-PlacingInYourRoom")
    }

    @Resources {
        If you want to go deeper, start here.

        @Documentation(destination: "https://developer.apple.com/documentation/realitykit") {
            Official RealityKit documentation.

            - [RealityView (iOS)](https://developer.apple.com/documentation/realitykit/realityview)
            - [SpatialTrackingSession](https://developer.apple.com/documentation/realitykit/spatialtrackingsession)
            - [Reality Composer Pro](https://developer.apple.com/documentation/visionos/designing-realitykit-content-with-reality-composer-pro)
        }

        @Videos(destination: "https://developer.apple.com/videos/") {
            WWDC sessions.

            - [Compose interactive 3D content in Reality Composer Pro (WWDC24)](https://developer.apple.com/videos/play/wwdc2024/10102/)
            - [Discover RealityKit APIs for iOS, macOS and visionOS (WWDC24)](https://developer.apple.com/videos/play/wwdc2024/10103/)
            - [Meet Reality Composer Pro (WWDC23)](https://developer.apple.com/videos/play/wwdc2023/10083/)
        }

        @SampleCode(destination: "https://developer.apple.com/documentation/realitykit/composing-interactive-3d-content-with-realitykit-and-reality-composer-pro") {
            Apple's official sample this tutorial follows, and the 3D asset.

            - [Composing interactive 3D content with RealityKit and Reality Composer Pro (Apple's official sample)](https://developer.apple.com/documentation/realitykit/composing-interactive-3d-content-with-realitykit-and-reality-composer-pro)
            - [AR Quick Look Gallery — the `seahorse.usdz` model](https://developer.apple.com/augmented-reality/quick-look/)
        }
    }
}
